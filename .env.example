# Exemplo de variáveis de ambiente (NÃO coloque segredos aqui)
# Copie para .env.local e preencha com seus valores.

# --- Next.js / Supabase (App) ---
# URL do projeto no Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do Supabase (Settings → API Keys)
# Novo formato: sb_publishable_... (recomendado)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Fallback legado (se seu projeto ainda usa JWT anon key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta do Supabase (APENAS server-side).
# Novo formato: sb_secret_... (recomendado)
# Nunca exponha no client e nunca comite.
SUPABASE_SECRET_KEY=
# Fallback legado (se seu projeto ainda usa JWT service_role key):
# SUPABASE_SERVICE_ROLE_KEY=

# --- Dev-only ---
# Habilita rotas internas de teste de IA em desenvolvimento.
ALLOW_AI_TEST_ROUTE=false

# Habilita rotas internas de mock de UI em desenvolvimento.
ALLOW_UI_MOCKS_ROUTE=false

# --- Installer (ops only) ---
# Se INSTALLER_ENABLED nao estiver definido, o instalador fica liberado ate a primeira instalacao.
# Defina como false para desativar o instalador (recomendado apos o setup).
INSTALLER_ENABLED=false

# Token opcional para proteger o instalador (se definido, passa a ser obrigatorio).
INSTALLER_TOKEN=

# --- Automações (motor de funis / follow-ups) ---
# Segredo que o cron do banco (pg_cron -> pg_net) manda como Bearer para /api/internal/automations/tick.
# O MESMO valor precisa estar no cofre do Supabase (vault) como `automation_tick_secret`,
# junto com `automation_tick_url` = https://<host>/api/internal/automations/tick.
# Ver docs/features/funil-construtor/OPERACAO-TICK.md.
AUTOMATION_TICK_SECRET=

# Segredo do worker/cron externo para /api/internal/automations/execute, jobs/claim e jobs/:id/complete.
AUTOMATION_WORKER_SECRET=

# Chave geral do executor de automações neste ambiente. Só "true" liga.
# Desligada: nenhum job e' executado (nem simulacao); mensagens reais nunca saem daqui.
# Ligada: ainda depende da chave por cliente (automation_live_enabled) e da versão publicada em modo live.
AUTOMATION_LIVE_SENDS_ENABLED=false
